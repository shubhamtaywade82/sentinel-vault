# Copy to .env for development (bin/setup generates one with random values).
# Every variable is required; the app refuses to boot without them.
VAULT_ADMIN_TOKEN=          # >= 32 chars, e.g. `openssl rand -hex 32`
VAULT_KMS_PROVIDER=local    # local (dev/test only) | aws_kms (required in production)
VAULT_MASTER_KEY=           # local provider: base64 of 32 bytes, `openssl rand -base64 32`
# VAULT_KMS_KEY_ID=         # aws_kms provider: KMS key id or ARN; AWS_REGION and credentials via the standard AWS chain
